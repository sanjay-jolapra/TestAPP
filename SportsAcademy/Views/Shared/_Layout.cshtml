<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sports Academy Pro</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
<div class="d-flex" id="wrapper">
    <!-- Sidebar -->
    <nav id="sidebar" class="sidebar d-flex flex-column">
        <div class="sidebar-brand">
            <i class="fas fa-trophy me-2"></i>
            <span>Sports Academy Pro</span>
        </div>
        @{
            var permSvc = Context.RequestServices.GetService<SportsAcademy.Services.PermissionService>();
            var roleIdClaim = User.FindFirst("RoleId")?.Value;
            int roleId = int.TryParse(roleIdClaim, out var rid) ? rid : 0;
            async Task<bool> CanView(string module) =>
                permSvc != null && roleId > 0 && await permSvc.HasPermissionAsync(roleId, module, "View");
        }
        <ul class="sidebar-nav flex-grow-1">
            @if (await CanView(SportsAcademy.Models.AppModules.Dashboard))
            {
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-tachometer-alt"></i> Dashboard
                </a>
            </li>
            }
            <li class="nav-section">MANAGEMENT</li>
            @if (await CanView(SportsAcademy.Models.AppModules.Batches))
            {
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Batches" ? "active" : "")" asp-controller="Batches" asp-action="Index">
                    <i class="fas fa-layer-group"></i> Batches
                </a>
            </li>
            }
            @if (await CanView(SportsAcademy.Models.AppModules.Students))
            {
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Students" ? "active" : "")" asp-controller="Students" asp-action="Index">
                    <i class="fas fa-users"></i> Students
                </a>
            </li>
            }
            @if (await CanView(SportsAcademy.Models.AppModules.Attendance))
            {
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Attendance" ? "active" : "")" asp-controller="Attendance" asp-action="Index">
                    <i class="fas fa-clipboard-check"></i> Attendance
                </a>
            </li>
            }
            @if (await CanView(SportsAcademy.Models.AppModules.Fees))
            {
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Fees" ? "active" : "")" asp-controller="Fees" asp-action="Index">
                    <i class="fas fa-rupee-sign"></i> Fees
                </a>
            </li>
            }
            <li class="nav-section">ASSESSMENTS</li>
            @if (await CanView(SportsAcademy.Models.AppModules.FitnessTests))
            {
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "FitnessTests" ? "active" : "")" asp-controller="FitnessTests" asp-action="Index">
                    <i class="fas fa-heartbeat"></i> Fitness Tests
                </a>
            </li>
            }
            @if (await CanView(SportsAcademy.Models.AppModules.MovementScreening))
            {
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "MovementScreening" ? "active" : "")" asp-controller="MovementScreening" asp-action="Index">
                    <i class="fas fa-walking"></i> Movement Screening
                </a>
            </li>
            }
            @if (await CanView(SportsAcademy.Models.AppModules.SkillDevelopment))
            {
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "SkillDevelopment" ? "active" : "")" asp-controller="SkillDevelopment" asp-action="Index">
                    <i class="fas fa-star"></i> Skill Development
                </a>
            </li>
            }
            @if (await CanView(SportsAcademy.Models.AppModules.StrengthConditioning))
            {
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "StrengthConditioning" ? "active" : "")" asp-controller="StrengthConditioning" asp-action="Index">
                    <i class="fas fa-dumbbell"></i> Strength &amp; Conditioning
                </a>
            </li>
            }
            @if (await CanView(SportsAcademy.Models.AppModules.MentalToughness))
            {
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "MentalToughness" ? "active" : "")" asp-controller="MentalToughness" asp-action="Index">
                    <i class="fas fa-brain"></i> Mental Toughness
                </a>
            </li>
            }
            @if (await CanView(SportsAcademy.Models.AppModules.Teamwork))
            {
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Teamwork" ? "active" : "")" asp-controller="Teamwork" asp-action="Index">
                    <i class="fas fa-handshake"></i> Teamwork &amp; Leadership
                </a>
            </li>
            }
            <li class="nav-section">HEALTH &amp; ANALYTICS</li>
            @if (await CanView(SportsAcademy.Models.AppModules.InjuryTracking))
            {
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "InjuryTracking" ? "active" : "")" asp-controller="InjuryTracking" asp-action="Index">
                    <i class="fas fa-band-aid"></i> Injury Tracking
                </a>
            </li>
            }
            @if (await CanView(SportsAcademy.Models.AppModules.Nutrition))
            {
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Nutrition" ? "active" : "")" asp-controller="Nutrition" asp-action="Index">
                    <i class="fas fa-apple-alt"></i> Nutrition
                </a>
            </li>
            }
            @if (await CanView(SportsAcademy.Models.AppModules.Performance))
            {
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Performance" ? "active" : "")" asp-controller="Performance" asp-action="Index">
                    <i class="fas fa-chart-line"></i> AI Performance Score
                </a>
            </li>
            }
            @if (await CanView(SportsAcademy.Models.AppModules.UserManagement))
            {
            <li class="nav-section">ADMINISTRATION</li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "")" asp-controller="Users" asp-action="Index">
                    <i class="fas fa-users-cog"></i> Users
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Roles" ? "active" : "")" asp-controller="Roles" asp-action="Index">
                    <i class="fas fa-user-shield"></i> Roles &amp; Permissions
                </a>
            </li>
            }
        </ul>
        <div class="sidebar-footer">
            <small>Sports Academy Pro &copy; @DateTime.Now.Year</small>
        </div>
    </nav>

    <!-- Page Content -->
    <div id="page-content-wrapper" class="flex-grow-1">
        <nav class="navbar navbar-expand-lg navbar-light topbar">
            <div class="container-fluid">
                <button class="btn btn-sm" id="sidebarToggle">
                    <i class="fas fa-bars"></i>
                </button>
                <span class="navbar-text ms-3 fw-semibold text-muted">@ViewData["Title"]</span>
                <div class="ms-auto d-flex align-items-center gap-2">
                    <span class="badge bg-primary"><i class="fas fa-calendar me-1"></i>@DateTime.Now.ToString("dd MMM yyyy")</span>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        var fullName = User.FindFirst("FullName")?.Value ?? User.Identity.Name;
                        var roleName = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown">
                                <i class="fas fa-user-circle"></i>
                                <span class="d-none d-md-inline">@fullName</span>
                                @if (!string.IsNullOrEmpty(roleName))
                                {
                                    <span class="badge bg-secondary d-none d-md-inline">@roleName</span>
                                }
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                <li><h6 class="dropdown-header">@fullName</h6></li>
                                @if (!string.IsNullOrEmpty(roleName))
                                {
                                    <li><span class="dropdown-item-text text-muted small">@roleName</span></li>
                                }
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">
                                        <i class="fas fa-key me-2"></i>Change Password
                                    </a>
                                </li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="fas fa-sign-out-alt me-2"></i>Sign Out
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </nav>

        <div class="content-area">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script src="~/js/site.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

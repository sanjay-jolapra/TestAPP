@model SportsAcademy.Controllers.LoginVM
@{
    Layout = null;
    ViewData["Title"] = "Login";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login – Sports Academy Pro</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        body { background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%); min-height: 100vh; display: flex; align-items: center; justify-content: center; }
        .login-card { background: rgba(255,255,255,0.05); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.1); border-radius: 16px; padding: 2.5rem; width: 100%; max-width: 420px; }
        .login-logo { font-size: 2.5rem; color: #f39c12; }
        .form-control { background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.2); color: #fff; }
        .form-control:focus { background: rgba(255,255,255,0.12); border-color: #f39c12; color: #fff; box-shadow: 0 0 0 0.25rem rgba(243,156,18,.25); }
        .form-control::placeholder { color: rgba(255,255,255,0.4); }
        .form-label { color: rgba(255,255,255,0.8); }
        .btn-login { background: linear-gradient(135deg, #f39c12, #e67e22); border: none; font-weight: 600; letter-spacing: .5px; }
        .btn-login:hover { background: linear-gradient(135deg, #e67e22, #d35400); }
        h2, .text-muted-light { color: #fff; }
        .text-muted-light { color: rgba(255,255,255,0.5) !important; }
        .form-check-label { color: rgba(255,255,255,0.7); }
    </style>
</head>
<body>
    <div class="login-card shadow-lg">
        <div class="text-center mb-4">
            <div class="login-logo mb-2"><i class="fas fa-trophy"></i></div>
            <h2 class="fw-bold mb-0">Sports Academy Pro</h2>
            <p class="text-muted-light small mt-1">Sign in to your account</p>
        </div>

        @if (!string.IsNullOrEmpty(ViewBag.Error as string))
        {
            <div class="alert alert-danger py-2"><i class="fas fa-exclamation-circle me-2"></i>@ViewBag.Error</div>
        }

        <form asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="mb-3">
                <label asp-for="Username" class="form-label">Username</label>
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0" style="border-color:rgba(255,255,255,.2);color:rgba(255,255,255,.5)"><i class="fas fa-user"></i></span>
                    <input asp-for="Username" class="form-control border-start-0" placeholder="Enter username" autocomplete="username" />
                </div>
                <span asp-validation-for="Username" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0" style="border-color:rgba(255,255,255,.2);color:rgba(255,255,255,.5)"><i class="fas fa-lock"></i></span>
                    <input asp-for="Password" class="form-control border-start-0" placeholder="Enter password" autocomplete="current-password" />
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="mb-4 form-check">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label">Remember me for 14 days</label>
            </div>
            <button type="submit" class="btn btn-login btn-primary w-100 py-2">
                <i class="fas fa-sign-in-alt me-2"></i>Sign In
            </button>
        </form>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

@{
    ViewData["Title"] = "Access Denied";
}
<div class="d-flex flex-column align-items-center justify-content-center" style="min-height:60vh">
    <div class="text-center">
        <div style="font-size:5rem;color:#e94560"><i class="fas fa-ban"></i></div>
        <h2 class="mt-3 fw-bold">Access Denied</h2>
        <p class="text-muted mb-4">You don't have permission to access this module.<br/>Contact your administrator to request access.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary me-2">
            <i class="fas fa-home me-1"></i>Go to Dashboard
        </a>
    </div>
</div>

@model IEnumerable<SportsAcademy.Models.Auth.AppUser>
@{
    ViewData["Title"] = "User Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1 fw-bold"><i class="fas fa-users-cog me-2 text-primary"></i>User Management</h4>
        <small class="text-muted">Manage application users and role assignments</small>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus me-1"></i>Add User</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <table id="usersTable" class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Username</th>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Last Login</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td><i class="fas fa-user-circle me-2 text-primary"></i><strong>@u.Username</strong></td>
                        <td>@u.FullName</td>
                        <td><small>@u.Email</small></td>
                        <td>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                @u.Role?.Name
                            </span>
                        </td>
                        <td>
                            @if (u.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success"><i class="fas fa-circle me-1" style="font-size:.5rem"></i>Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger"><i class="fas fa-circle me-1" style="font-size:.5rem"></i>Inactive</span>
                            }
                        </td>
                        <td><small class="text-muted">@(u.LastLoginAt.HasValue ? u.LastLoginAt.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm") : "Never")</small></td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary me-1">
                                <i class="fas fa-edit"></i>
                            </a>
                            @if (u.Username != "admin")
                            {
                                <form asp-action="Delete" asp-route-id="@u.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete user @u.Username?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>$(document).ready(function(){ $('#usersTable').DataTable({ pageLength: 25, order: [[0,'asc']] }); });</script>
}

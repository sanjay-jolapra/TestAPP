@model MovementScreeningTest
@{ViewData["Title"] = "Add Movement Test";}
<div class="page-header"><div><h1 class="page-title">Add Movement Screening Test</h1></div><a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Back</a></div>
<div class="card" style="max-width:600px;"><div class="card-body"><form asp-action="CreateTest" method="post">@Html.AntiForgeryToken()
<div class="row g-3">
<div class="col-12"><label class="form-label">Test Name *</label><input asp-for="Name" class="form-control" placeholder="e.g. Deep Squat" /></div>
<div class="col-md-6"><label class="form-label">Measurement Unit</label><input asp-for="MeasurementUnit" class="form-control" placeholder="e.g. reps, score" /></div>
<div class="col-md-6"><label class="form-label">Measures</label><input asp-for="Measures" class="form-control" placeholder="e.g. Mobility" /></div>
<div class="col-12"><label class="form-label">Description</label><textarea asp-for="Description" class="form-control" rows="2"></textarea></div>
<div class="col-12 form-check ms-2"><input asp-for="IsActive" class="form-check-input" type="checkbox" /><label class="form-check-label">Active</label></div>
<div class="col-12"><button type="submit" class="btn btn-primary"><i class="fas fa-save me-2"></i>Save</button></div>
</div></form></div></div>

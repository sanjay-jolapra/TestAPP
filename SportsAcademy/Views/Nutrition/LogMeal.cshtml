@model NutritionLog
@{ViewData["Title"] = "Log Meal";}
<div class="page-header"><div><h1 class="page-title">Log Meal</h1></div><a asp-action="Index" class="btn btn-outline-secondary">Back</a></div>
<div class="card" style="max-width:700px;"><div class="card-body"><form asp-action="LogMeal" method="post">@Html.AntiForgeryToken()
<div class="row g-3">
<div class="col-md-6"><label class="form-label">Student *</label><select asp-for="StudentId" asp-items="ViewBag.Students" class="form-select"><option value="">Select Student</option></select></div>
<div class="col-md-6"><label class="form-label">Date *</label><input asp-for="Date" type="date" class="form-control" /></div>
<div class="col-md-6"><label class="form-label">Meal Type *</label><select asp-for="MealType" asp-items="Html.GetEnumSelectList<MealType>()" class="form-select"></select></div>
<div class="col-12"><label class="form-label">Food Items</label><textarea asp-for="FoodItems" class="form-control" rows="2" placeholder="List the food items consumed"></textarea></div>
<div class="col-md-3"><label class="form-label">Calories</label><input asp-for="Calories" class="form-control" type="number" step="0.1" /></div>
<div class="col-md-3"><label class="form-label">Protein (g)</label><input asp-for="Protein" class="form-control" type="number" step="0.1" /></div>
<div class="col-md-3"><label class="form-label">Carbs (g)</label><input asp-for="Carbs" class="form-control" type="number" step="0.1" /></div>
<div class="col-md-3"><label class="form-label">Fats (g)</label><input asp-for="Fats" class="form-control" type="number" step="0.1" /></div>
<div class="col-md-4"><label class="form-label">Water (ml)</label><input asp-for="WaterMl" class="form-control" type="number" /></div>
<div class="col-12"><label class="form-label">Notes</label><textarea asp-for="Notes" class="form-control" rows="2"></textarea></div>
<div class="col-12"><button type="submit" class="btn btn-primary"><i class="fas fa-save me-2"></i>Save Meal</button></div>
</div></form></div></div>

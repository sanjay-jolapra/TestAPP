@model IEnumerable<NutritionLog>
@{ViewData["Title"] = "Nutrition Tracking";}
<div class="page-header"><div><h1 class="page-title">Nutrition Tracking</h1></div>
<a asp-action="LogMeal" class="btn btn-primary btn-sm"><i class="fas fa-plus me-1"></i>Log Meal</a></div>

<div class="card mb-3"><div class="card-body py-2"><form method="get" class="row g-2 align-items-end">
<div class="col-md-4"><label class="form-label mb-1 small">Student</label><select name="studentId" asp-items="ViewBag.Students" class="form-select form-select-sm"><option value="">Select Student</option></select></div>
<div class="col-md-3"><label class="form-label mb-1 small">Date</label><input type="date" name="date" value="@ViewBag.Date?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" /></div>
<div class="col-md-2"><button type="submit" class="btn btn-primary btn-sm w-100">View</button></div>
@if(ViewBag.Student != null){<div class="col-md-3"><a asp-action="SetGoal" asp-route-studentId="@ViewBag.Student?.Id" class="btn btn-outline-info btn-sm w-100"><i class="fas fa-bullseye me-1"></i>Set Goals</a></div>}
</form></div></div>

@if(Model.Any())
{
    var goal = ViewBag.Goal as NutritionGoal;
    <div class="row g-3 mb-3">
        <div class="col-md-3"><div class="card text-center p-3 @(goal!=null&&ViewBag.TotalCalories>goal.DailyCalories?"border-danger":"")"><div class="fw-bold fs-4">@ViewBag.TotalCalories.ToString("N0")</div><small class="text-muted">Calories @(goal?.DailyCalories.HasValue==true?$"/ {goal.DailyCalories:N0}":"")</small></div></div>
        <div class="col-md-3"><div class="card text-center p-3"><div class="fw-bold fs-4 text-primary">@ViewBag.TotalProtein.ToString("N0")g</div><small class="text-muted">Protein @(goal?.ProteinGoal.HasValue==true?$"/ {goal.ProteinGoal:N0}g":"")</small></div></div>
        <div class="col-md-3"><div class="card text-center p-3"><div class="fw-bold fs-4 text-warning">@ViewBag.TotalCarbs.ToString("N0")g</div><small class="text-muted">Carbs @(goal?.CarbsGoal.HasValue==true?$"/ {goal.CarbsGoal:N0}g":"")</small></div></div>
        <div class="col-md-3"><div class="card text-center p-3"><div class="fw-bold fs-4 text-danger">@ViewBag.TotalFats.ToString("N0")g</div><small class="text-muted">Fats @(goal?.FatsGoal.HasValue==true?$"/ {goal.FatsGoal:N0}g":"")</small></div></div>
    </div>

    <div class="card"><div class="card-header bg-white"><h6 class="mb-0 fw-bold">@ViewBag.Student?.Name — @ViewBag.Date?.ToString("dd MMMM yyyy")</h6></div>
    <div class="card-body p-0"><table class="table table-hover mb-0">
    <thead class="table-light"><tr><th>Meal</th><th>Food Items</th><th>Calories</th><th>Protein</th><th>Carbs</th><th>Fats</th><th>Water (ml)</th></tr></thead>
    <tbody>
    @foreach(var l in Model)
    {<tr><td><span class="badge bg-primary">@l.MealType</span></td><td>@l.FoodItems</td>
    <td>@l.Calories?.ToString("N0")</td><td>@l.Protein?.ToString("N1")g</td>
    <td>@l.Carbs?.ToString("N1")g</td><td>@l.Fats?.ToString("N1")g</td><td>@l.WaterMl?.ToString("N0")</td></tr>}
    </tbody></table></div></div>
}
else if(ViewBag.Student != null)
{<div class="alert alert-info">No nutrition logs for this date. <a asp-action="LogMeal" asp-route-studentId="@ViewBag.Student?.Id">Log a meal</a></div>}

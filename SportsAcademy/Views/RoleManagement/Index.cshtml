@model IEnumerable<SportsAcademy.Models.Auth.AppRole>
@{
    ViewData["Title"] = "Role Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1 fw-bold"><i class="fas fa-shield-alt me-2 text-primary"></i>Role Management</h4>
        <small class="text-muted">Define roles and assign module-level permissions</small>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus me-1"></i>Add Role</a>
</div>

<div class="row g-3">
    @foreach (var role in Model)
    {
        <div class="col-md-6 col-xl-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h5 class="mb-1 fw-bold">@role.Name</h5>
                            <small class="text-muted">@(role.Description ?? "No description")</small>
                        </div>
                        @if (role.IsActive)
                        {
                            <span class="badge bg-success-subtle text-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary">Inactive</span>
                        }
                    </div>
                    <div class="d-flex gap-3 text-center mb-3">
                        <div>
                            <div class="fw-bold text-primary fs-5">@role.Users.Count</div>
                            <small class="text-muted">Users</small>
                        </div>
                        <div>
                            <div class="fw-bold text-primary fs-5">@role.Permissions.Count</div>
                            <small class="text-muted">Modules</small>
                        </div>
                        <div>
                            <div class="fw-bold text-primary fs-5">@role.Permissions.Count(p => p.CanCreate)</div>
                            <small class="text-muted">Can Create</small>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@role.Id" class="btn btn-sm btn-outline-primary flex-grow-1">
                            <i class="fas fa-edit me-1"></i>Edit Permissions
                        </a>
                        @if (role.Name != "SuperAdmin" && !role.Users.Any())
                        {
                            <form asp-action="Delete" asp-route-id="@role.Id" method="post"
                                  onsubmit="return confirm('Delete role @role.Name?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

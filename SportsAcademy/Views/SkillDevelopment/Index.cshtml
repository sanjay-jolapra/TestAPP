@model IEnumerable<SkillGroup>
@{ViewData["Title"] = "Skill Development";}
<div class="page-header">
    <div><h1 class="page-title">Skill Development</h1></div>
    <div class="d-flex gap-2">
        <a asp-action="RecordResult" class="btn btn-success btn-sm"><i class="fas fa-plus me-1"></i>Record Result</a>
        <a asp-action="Results" class="btn btn-outline-primary btn-sm"><i class="fas fa-list me-1"></i>Results</a>
        <a asp-action="CreateSkill" class="btn btn-outline-info btn-sm"><i class="fas fa-plus me-1"></i>Add Skill</a>
        <a asp-action="CreateGroup" class="btn btn-outline-secondary btn-sm"><i class="fas fa-plus me-1"></i>Add Group</a>
    </div>
</div>
@foreach (var g in Model)
{
    <div class="card mb-3">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold"><i class="fas fa-folder-open me-2 text-warning"></i>@g.Name</h6>
            <a asp-action="CreateSkill" asp-route-groupId="@g.Id" class="btn btn-sm btn-outline-success"><i class="fas fa-plus me-1"></i>Add Skill</a>
        </div>
        <div class="card-body">
            @if (g.Skills.Any())
            {
                <div class="row g-2">
                    @foreach (var s in g.Skills)
                    {
                        <div class="col-md-3">
                            <div class="border rounded p-2">
                                <div class="fw-semibold small">@s.Name</div>
                                @if(!string.IsNullOrEmpty(s.Measures)){<small class="text-muted d-block">@s.Measures</small>}
                                @if(!string.IsNullOrEmpty(s.MeasurementUnit)){<span class="badge bg-light text-dark" style="font-size:.7rem;">@s.MeasurementUnit</span>}
                            </div>
                        </div>
                    }
                </div>
            }
            else { <p class="text-muted small mb-0">No skills added yet.</p> }
        </div>
    </div>
}

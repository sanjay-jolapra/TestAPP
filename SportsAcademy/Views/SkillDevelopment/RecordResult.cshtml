@model SkillAssessmentResult
@{ViewData["Title"] = "Record Skill Result";}
<div class="page-header"><div><h1 class="page-title">Record Skill Assessment</h1></div><a asp-action="Results" class="btn btn-outline-secondary">Results</a></div>
<div class="card" style="max-width:600px;"><div class="card-body"><form asp-action="RecordResult" method="post">@Html.AntiForgeryToken()
<div class="row g-3">
<div class="col-md-6"><label class="form-label">Skill *</label><select asp-for="SkillId" asp-items="ViewBag.Skills" class="form-select"><option value="">Select Skill</option></select></div>
<div class="col-md-6"><label class="form-label">Student *</label><select asp-for="StudentId" asp-items="ViewBag.Students" class="form-select"><option value="">Select Student</option></select></div>
<div class="col-md-6"><label class="form-label">Date *</label><input asp-for="AssessmentDate" type="date" class="form-control" /></div>
<div class="col-md-6"><label class="form-label">Value *</label><input asp-for="Value" class="form-control" /></div>
<div class="col-md-6"><label class="form-label">Score (1-10)</label><input asp-for="Score" class="form-control" type="number" min="1" max="10" /></div>
<div class="col-12"><label class="form-label">Notes</label><textarea asp-for="Notes" class="form-control" rows="2"></textarea></div>
<div class="col-12"><button type="submit" class="btn btn-primary"><i class="fas fa-save me-2"></i>Save</button></div>
</div></form></div></div>

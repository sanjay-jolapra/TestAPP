@model IEnumerable<InjuryRecord>
@{ViewData["Title"] = "Injury History";}
<div class="page-header"><div><h1 class="page-title">Injury History</h1><p class="page-subtitle">@ViewBag.Student?.Name</p></div>
<a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back</a></div>
<div class="card"><div class="card-body"><table class="table table-hover">
<thead><tr><th>Date</th><th>Injury</th><th>Body Part</th><th>Severity</th><th>Status</th><th>Treatment</th><th>Return</th></tr></thead>
<tbody>
@foreach(var r in Model)
{<tr><td>@r.InjuryDate.ToString("dd MMM yyyy")</td><td>@r.InjuryType</td><td>@r.BodyPart</td>
<td><span class="badge @(r.Severity==InjurySeverity.Severe?"bg-danger":r.Severity==InjurySeverity.Moderate?"bg-warning":"bg-success")">@r.Severity</span></td>
<td><span class="badge @(r.Status==InjuryStatus.Active?"bg-danger":r.Status==InjuryStatus.Recovered?"bg-success":"bg-warning")">@r.Status</span></td>
<td><small>@r.TreatmentGiven</small></td><td>@(r.ReturnDate?.ToString("dd MMM yyyy")??"-")</td></tr>}
</tbody></table></div></div>

@model IEnumerable<SportsAcademy.Models.AppUser>
@{
    ViewData["Title"] = "Users";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0"><i class="fas fa-users-cog me-2 text-primary"></i>User Management</h4>
    <a asp-action="Create" class="btn btn-primary btn-sm">
        <i class="fas fa-plus me-1"></i> Add User
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0 datatable">
            <thead class="table-light">
                <tr>
                    <th>Full Name</th>
                    <th>Username</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Last Login</th>
                    <th>Created</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td class="fw-semibold">@u.FullName</td>
                        <td><code>@u.Username</code></td>
                        <td>@u.Email</td>
                        <td><span class="badge bg-secondary">@u.Role?.Name</span></td>
                        <td>
                            @if (u.IsActive)
                            { <span class="badge bg-success">Active</span> }
                            else
                            { <span class="badge bg-danger">Inactive</span> }
                        </td>
                        <td class="text-muted small">@(u.LastLoginAt.HasValue ? u.LastLoginAt.Value.ToString("dd MMM yyyy HH:mm") : "Never")</td>
                        <td class="text-muted small">@u.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary">
                                <i class="fas fa-edit"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@u.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete user @u.Username?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

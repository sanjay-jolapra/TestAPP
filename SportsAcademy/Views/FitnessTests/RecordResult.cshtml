@model FitnessTestResult
@{ViewData["Title"] = "Record Fitness Result";}
<div class="page-header"><div><h1 class="page-title">Record Fitness Result</h1></div><a asp-action="Results" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>View Results</a></div>
<div class="card" style="max-width:600px;">
    <div class="card-body">
        <form asp-action="RecordResult" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-6"><label class="form-label">Test *</label><select asp-for="FitnessTestId" asp-items="ViewBag.Tests" class="form-select"><option value="">Select Test</option></select></div>
                <div class="col-md-6"><label class="form-label">Student *</label><select asp-for="StudentId" asp-items="ViewBag.Students" class="form-select"><option value="">Select Student</option></select></div>
                <div class="col-md-6"><label class="form-label">Test Date *</label><input asp-for="TestDate" type="date" class="form-control" /></div>
                <div class="col-md-6"><label class="form-label">Value / Result *</label><input asp-for="Value" class="form-control" placeholder="e.g. 3.2 or 15" /></div>
                <div class="col-12"><label class="form-label">Notes</label><textarea asp-for="Notes" class="form-control" rows="2"></textarea></div>
                <div class="col-12"><hr /><button type="submit" class="btn btn-primary"><i class="fas fa-save me-2"></i>Save Result</button></div>
            </div>
        </form>
    </div>
</div>

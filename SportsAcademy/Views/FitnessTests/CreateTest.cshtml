@model FitnessTest
@{ViewData["Title"] = "Add Fitness Test";}
<div class="page-header"><div><h1 class="page-title">Add Fitness Test</h1></div><a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Back</a></div>
<div class="card" style="max-width:600px;">
    <div class="card-body">
        <form asp-action="CreateTest" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-12"><label class="form-label">Test Name *</label><input asp-for="Name" class="form-control" placeholder="e.g. 20m Sprint" /><span asp-validation-for="Name" class="text-danger small"></span></div>
                <div class="col-md-6"><label class="form-label">Measurement Unit</label><input asp-for="MeasurementUnit" class="form-control" placeholder="e.g. seconds, cm, reps" /></div>
                <div class="col-md-6"><label class="form-label">Measures</label><input asp-for="Measures" class="form-control" placeholder="e.g. Speed, Agility" /></div>
                <div class="col-12"><label class="form-label">Description</label><textarea asp-for="Description" class="form-control" rows="2"></textarea></div>
                <div class="col-12 form-check ms-2"><input asp-for="IsActive" class="form-check-input" type="checkbox" /><label class="form-check-label">Active</label></div>
                <div class="col-12"><hr /><button type="submit" class="btn btn-primary"><i class="fas fa-save me-2"></i>Save Test</button></div>
            </div>
        </form>
    </div>
</div>

@model IEnumerable<Batch>
@{ViewData["Title"] = "Batches";}
<div class="page-header"><div><h1 class="page-title">Batches</h1></div><a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus me-1"></i>Add Batch</a></div>
<div class="row g-3">
@foreach (var b in Model)
{<div class="col-md-4"><div class="card"><div class="card-body">
<h6 class="fw-bold">@b.Name</h6>
@if(b.StartTime.HasValue){<div class="text-muted small"><i class="fas fa-clock me-1"></i>@b.StartTime.Value.ToString(@"hh\:mm") - @b.EndTime?.ToString(@"hh\:mm")</div>}
<p class="text-muted small mb-2">@b.Description</p>
<span class="badge bg-primary">@b.Students.Count students</span>
</div><div class="card-footer bg-white">
<div class="btn-group btn-group-sm w-100">
<a asp-action="Edit" asp-route-id="@b.Id" class="btn btn-outline-primary"><i class="fas fa-edit me-1"></i>Edit</a>
<form asp-action="Delete" asp-route-id="@b.Id" method="post" onsubmit="return confirm('Delete batch?');" style="display:inline;flex:1"><button type="submit" class="btn btn-outline-danger w-100">@Html.AntiForgeryToken()<i class="fas fa-trash"></i></button></form>
</div></div></div></div>}
</div>

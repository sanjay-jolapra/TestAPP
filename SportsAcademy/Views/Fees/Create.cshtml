@model FeePayment
@{ViewData["Title"] = "Record Fee Payment";}

<div class="page-header">
    <div><h1 class="page-title">Record Fee Payment</h1></div>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Back</a>
</div>

<div class="card" style="max-width:700px;">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-6"><label class="form-label">Student *</label><select asp-for="StudentId" asp-items="ViewBag.Students" class="form-select"><option value="">Select Student</option></select><span asp-validation-for="StudentId" class="text-danger small"></span></div>
                <div class="col-md-6"><label class="form-label">Amount (₹) *</label><input asp-for="Amount" class="form-control" placeholder="0.00" /><span asp-validation-for="Amount" class="text-danger small"></span></div>
                <div class="col-md-6"><label class="form-label">Payment Date *</label><input asp-for="PaidDate" type="date" class="form-control" /></div>
                <div class="col-md-6"><label class="form-label">Period Type *</label><select asp-for="PeriodType" asp-items="Html.GetEnumSelectList<FeePeriodType>()" class="form-select"></select></div>
                <div class="col-md-4"><label class="form-label">Month</label><select asp-for="PeriodMonth" class="form-select"><option value="">-</option>@for(int m=1;m<=12;m++){<option value="@m">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>}</select></div>
                <div class="col-md-4"><label class="form-label">Year</label><select asp-for="PeriodYear" class="form-select">@for(int y=DateTime.Now.Year;y>=DateTime.Now.Year-3;y--){<option value="@y">@y</option>}</select></div>
                <div class="col-md-4"><label class="form-label">Receipt No.</label><input asp-for="ReceiptNo" class="form-control" placeholder="Optional" /></div>
                <div class="col-12"><label class="form-label">Notes</label><textarea asp-for="Notes" class="form-control" rows="2"></textarea></div>
                <div class="col-12"><hr /><button type="submit" class="btn btn-primary px-4"><i class="fas fa-save me-2"></i>Save Payment</button><a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a></div>
            </div>
        </form>
    </div>
</div>

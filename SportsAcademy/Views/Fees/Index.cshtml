@model IEnumerable<FeePayment>
@{ViewData["Title"] = "Fees Management";}

<div class="page-header">
    <div><h1 class="page-title">Fees Management</h1><p class="page-subtitle">Total: ₹@ViewBag.TotalAmount.ToString("N0")</p></div>
    <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus me-2"></i>Record Payment</a>
</div>

<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-5"><label class="form-label mb-1 small fw-semibold">Student</label><select name="studentId" asp-items="ViewBag.Students" class="form-select form-select-sm"><option value="">All Students</option></select></div>
            <div class="col-md-3"><label class="form-label mb-1 small fw-semibold">Year</label><select name="year" class="form-select form-select-sm">@for(int y=DateTime.Now.Year;y>=DateTime.Now.Year-3;y--){<option value="@y" @(ViewBag.Year==y?"selected":"")>@y</option>}</select></div>
            <div class="col-md-2"><button type="submit" class="btn btn-primary btn-sm w-100">Filter</button></div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover data-table">
                <thead><tr><th>Student</th><th>Amount</th><th>Paid Date</th><th>Period</th><th>Receipt</th><th>Notes</th><th>Actions</th></tr></thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td><a asp-action="StudentLedger" asp-route-studentId="@p.StudentId" class="fw-semibold text-decoration-none">@p.Student?.Name</a></td>
                            <td><span class="fw-bold text-success">₹@p.Amount.ToString("N0")</span></td>
                            <td>@p.PaidDate.ToString("dd MMM yyyy")</td>
                            <td>
                                <span class="badge bg-info">@p.PeriodType</span>
                                @if (p.PeriodMonth.HasValue){ <small class="text-muted">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(p.PeriodMonth.Value) @p.PeriodYear</small> }
                            </td>
                            <td><code>@p.ReceiptNo</code></td>
                            <td><small>@p.Notes</small></td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-outline-primary"><i class="fas fa-edit"></i></a>
                                    <form asp-action="Delete" asp-route-id="@p.Id" method="post" onsubmit="return confirm('Delete?');" style="display:inline;">@Html.AntiForgeryToken()<button type="submit" class="btn btn-outline-danger"><i class="fas fa-trash"></i></button></form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

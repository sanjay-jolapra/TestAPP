@model IEnumerable<AttendanceRecord>
@{ViewData["Title"] = "Attendance Report";}

<div class="page-header">
    <div><h1 class="page-title">Attendance Report</h1></div>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Back</a>
</div>

<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label mb-1 small fw-semibold">Student</label>
                <select name="studentId" asp-items="ViewBag.Students" class="form-select form-select-sm">
                    <option value="">Select Student</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label mb-1 small fw-semibold">Month</label>
                <select name="month" class="form-select form-select-sm">
                    @for (int m = 1; m <= 12; m++)
                    {<option value="@m" @(ViewBag.Month == m ? "selected" : "")>@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>}
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label mb-1 small fw-semibold">Year</label>
                <select name="year" class="form-select form-select-sm">
                    @for (int y = DateTime.Now.Year; y >= DateTime.Now.Year - 3; y--)
                    {<option value="@y" @(ViewBag.Year == y ? "selected" : "")>@y</option>}
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary btn-sm w-100">View Report</button>
            </div>
        </form>
    </div>
</div>

@if (Model.Any())
{
    <div class="row g-3 mb-3">
        <div class="col-4"><div class="card text-center p-3"><div class="fw-bold fs-3 text-success">@ViewBag.PresentCount</div><small>Present</small></div></div>
        <div class="col-4"><div class="card text-center p-3"><div class="fw-bold fs-3 text-danger">@ViewBag.AbsentCount</div><small>Absent</small></div></div>
        <div class="col-4"><div class="card text-center p-3"><div class="fw-bold fs-3 text-warning">@ViewBag.LateCount</div><small>Late</small></div></div>
    </div>

    <div class="card">
        <div class="card-header bg-white"><h6 class="mb-0 fw-bold">@ViewBag.Student?.Name — @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName((int)ViewBag.Month) @ViewBag.Year</h6></div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light"><tr><th>Date</th><th>Day</th><th>Status</th><th>Notes</th></tr></thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            <tr>
                                <td>@r.Date.ToString("dd MMM yyyy")</td>
                                <td>@r.Date.DayOfWeek</td>
                                <td>
                                    <span class="badge @(r.Status == AttendanceStatus.Present ? "bg-success" : r.Status == AttendanceStatus.Late ? "bg-warning" : "bg-danger")">
                                        @r.Status
                                    </span>
                                </td>
                                <td>@r.Notes</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else if (ViewBag.Student != null)
{
    <div class="alert alert-info">No attendance records found for the selected period.</div>
}
